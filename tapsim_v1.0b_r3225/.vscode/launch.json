{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "C/C++: g++ build and debug active file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/tapsim",
            "args": ["emission","${workspaceFolder}/bin/config-file", "${workspaceFolder}/bin/emitterRelax.txt", "--write-ascii","--write-surface=surf.txt","--ref-work-function=1.0","--ref-potential=1.0"],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "make",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
